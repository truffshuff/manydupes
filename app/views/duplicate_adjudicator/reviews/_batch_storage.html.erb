<% if @batch_preview %>
  <% eligible = @batch_preview.count { |entry| entry[:status] == :eligible } %>
  <div class="da-storage-paths" tabindex="-1" data-action-result>
    <h2>Hard-link plan</h2>
    <p>Keeper <code><%= copy_label(@batch_keeper) %></code></p>
    <p><%= pluralize(eligible, "copy") %> eligible to link. Original files are retained under <code><%= @restore_root %></code>.</p>
    <% if eligible.positive? %>
      <p class="da-muted">Uncheck any copies you want to keep independent. Both Manyfold paths stay in place. In-place edits will affect linked copies.</p>
    <% end %>
  </div>
  <% if @batch_token %>
    <%= form_with url: group_action_url("link"), method: :post, local: true, class: "da-storage-form",
      data: {inline_form: true, scroll_to_result: true, link_plan: true} do %>
      <%= hidden_field_tag :plan, @batch_token, id: nil %>
      <fieldset class="da-batch-targets">
        <legend>Copies to link</legend>
        <% @batch_preview.select { |entry| entry[:status] == :eligible }.each do |entry| %>
          <label>
            <% if @batch_whole_group %>
              <%= check_box_tag "targets[]", entry.fetch(:copy).public_id, true, id: nil %>
            <% end %>
            <span><%= copy_label(entry.fetch(:copy)) %>
              <% if (bytes = entry.fetch(:plan).pair.bytes) %>
                <span class="da-muted">· Up to <%= number_to_human_size(bytes) %> after purge</span>
              <% end %>
            </span>
          </label>
        <% end %>
      </fieldset>
      <label>
        <%= check_box_tag :acknowledge, "1", true, id: nil %>
        Acknowledge Manyfold warnings for linked copies
      </label>
      <p class="da-muted">Use the cards if you want to acknowledge copies you keep independent.</p>
      <%= button_tag "Link selected copies and keep backups", name: "confirm", value: "1", class: "da-button da-primary" %>
    <% end %>
  <% end %>

  <% other = @batch_preview.reject { |entry| entry[:status] == :eligible } %>
  <% if other.any? %>
    <ul class="da-batch-results">
      <% other.each do |entry| %>
        <li>
          <%= copy_label(entry.fetch(:copy)) %> · <%= entry[:status] == :shared ? "Already shares the keeper’s file." : entry.fetch(:message) %>
          <% if entry[:independent] %>
            <%= button_to "Review independent copy",
              group_action_url("independent", left: @batch_keeper.public_id, right: entry.fetch(:copy).public_id),
              class: "da-button", form: {data: {inline_form: true, scroll_to_result: true}} %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% if @batch_results %>
  <% counts = @batch_results.map { |entry| entry.fetch(:status) }.tally %>
  <% labels = {linked: "linked", shared: "already shared the keeper’s file", attention: "linked, backup needs review", failed: "could not link", skipped: "left unchanged"} %>
  <div class="da-note da-storage-paths" role="status" tabindex="-1" data-action-result>
    <h2>Hard-link results</h2>
    <p><%= labels.filter_map { |status, label| "#{counts[status]} #{label}" if counts[status] }.join(" · ") %></p>
  </div>
  <ul class="da-batch-results">
    <% @batch_results.each do |entry| %>
      <li>
        <%= copy_label(entry.fetch(:copy)) %> · <%= labels.fetch(entry.fetch(:status)).capitalize %>.
        <% if entry[:id] %>
          <%= link_to "View saved original", backups_url(anchor: "backup-#{entry[:id]}") %>.
        <% end %>
        <%= entry[:message] %>
        <% if entry[:independent] %>
          <%= button_to "Review independent copy",
            group_action_url("independent", left: @batch_keeper.public_id, right: entry.fetch(:copy).public_id),
            class: "da-button", form: {data: {inline_form: true, scroll_to_result: true}} %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
