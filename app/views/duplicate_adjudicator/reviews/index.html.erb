<%= render "assets" %>

<div class="da" data-turbo="false" data-queue-view="<%= @review_view || "pending" %>" data-review-namespace="<%= review_namespace %>" data-import-url="<%= review_import_url %>" data-import-csrf="<%= form_authenticity_token %>">
  <header class="da-header">
    <div class="da-brand">
      <span class="da-brand-mark" aria-hidden="true"><span></span></span>
      <h1><%= t("manydupes.name") %></h1>
      <p><%= t("manydupes.queue_description") %></p>
    </div>
    <div class="da-actions da-header-action">
      <%= link_to "Manyfold duplicate warnings", native_duplicate_warnings_url, class: "da-button" %>
      <%= link_to "Restore backups", backups_url, class: "da-button" %>
    </div>
  </header>

  <div class="da-body">
    <nav class="da-review-views" aria-label="Review queue">
      <%= link_to "Needs review", queue_url(review: nil),
        aria: {current: @review_view.nil? ? "page" : nil} %>
      <%= link_to "All groups", queue_url(review: "all"),
        aria: {current: @review_view == "all" ? "page" : nil} %>
    </nav>
    <%= form_with url: queue_url(library: nil, q: nil, after: nil, sort: nil), method: :get, local: true, class: "da-panel da-filters" do %>
      <%= hidden_field_tag :review, @review_view, id: nil if @review_view %>
      <div>
        <%= label_tag :library, "Library" %>
        <%= select_tag :library, options_for_select(@libraries.map { |library| [library.name, library.public_id] }, @library&.public_id), include_blank: "All libraries", class: "form-select" %>
      </div>
      <div>
        <%= label_tag :q, "Filename, folder, or model" %>
        <%= search_field_tag :q, @search, maxlength: 160, autocomplete: "off", class: "form-control" %>
      </div>
      <div>
        <%= label_tag :sort, "Sort by" %>
        <%= select_tag :sort, options_for_select([["Checksum order", ""], ["Largest estimated savings", "savings"]], @sort), class: "form-select" %>
      </div>
      <%= submit_tag "Filter", class: "da-button da-primary" %>
      <% if @library || @search.present? %>
        <%= link_to "Clear", queue_url(library: nil, q: nil, after: nil), class: "da-button" %>
      <% end %>
    <% end %>

    <% if @library || @search.present? %>
      <p class="da-muted">A group is listed if any copy matches the filter. Opening it shows all indexed copies you can access.</p>
    <% end %>

    <% if @sort %>
      <p class="da-muted">Savings estimates use indexed file sizes. The hard-link plan checks storage eligibility and allocated space.</p>
    <% end %>

    <% if @groups.empty? %>
      <div class="da-panel">
        <h2>No matching groups</h2>
        <p><%= @after ? "You’ve reached the end of these results." : "No files with duplicate indexed checksums match these filters." %></p>
      </div>
    <% else %>
      <% unless SiteSettings.demo_mode_enabled? %>
        <section class="da-panel da-section" data-page-links hidden>
          <h2>Bulk links for this page</h2>
          <%= form_with url: page_link_url("plan"), method: :post, local: true, class: "da-actions",
            data: {page_link_preview: true} do |form| %>
            <div>
              <%= form.label :keeper_rule, "Keeper rule" %>
              <%= form.select :keeper_rule, DuplicateAdjudicator::ReviewsController::PAGE_KEEPERS.map { |value, label| [label, value] } %>
            </div>
            <%= form.submit "Review page link plan", class: "da-button da-primary" %>
          <% end %>
          <p class="da-muted" data-page-link-status role="status"></p>
          <div data-page-link-content></div>
        </section>
      <% end %>
      <div class="da-queue" aria-label="Duplicate checksum groups" data-review-queue
        data-page-size="<%= DuplicateAdjudicator::Index::GROUPS_PER_PAGE %>" data-next-after="<%= @next_page %>"
        data-page-url="<%= queue_url(after: nil) %>" data-link-check-url="<%= queue_links_url %>"
        data-refill-url="<%= queue_url(after: nil, refill: "1", queue_after: @after) if @review_view.nil? %>">
        <%= render "queue_rows" %>
      </div>
      <% if @review_view.nil? %>
        <% reviewable = @groups.any? do |group|
          !@queue_review[group.digest] || native_warning_status(@queue_copy_progress.fetch(group.digest))
        end %>
        <p class="da-load-status" data-queue-loading role="status" hidden>Loading more groups to review…</p>
        <div class="da-actions" data-queue-error hidden>
          <p class="da-muted" role="status">Could not load more review groups.</p>
          <button type="button" class="da-button" data-queue-retry>Retry loading groups</button>
        </div>
        <p class="da-panel da-muted" data-queue-empty <%= "hidden" if @next_page || reviewable %>>
          No more groups need review. <%= link_to "Show all groups", queue_url(review: "all") %>
        </p>
      <% end %>
    <% end %>

    <% if @after || @next_page %>
      <nav aria-label="Duplicate groups pages" class="da-actions">
        <% if @after %>
          <%= link_to "First page", queue_url(after: nil), class: "da-button" %>
        <% end %>
        <% if @next_page %>
          <%= link_to "Next page", queue_url(after: @next_page), class: "da-button da-primary",
            data: {queue_next: true} %>
        <% end %>
      </nav>
    <% end %>
  </div>
</div>
