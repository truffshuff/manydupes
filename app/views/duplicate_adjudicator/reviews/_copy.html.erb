<% warning_state = @warning_states[copy.id] %>
<article class="da-panel da-copy" data-copy-id="<%= copy.public_id %>" data-copy-side="<%= side %>" data-warning-state="<%= warning_state %>">
  <% if side %>
    <p class="da-copy-side"><%= side %></p>
  <% end %>
  <h2><%= file.filename %></h2>
  <p><%= link_to file.model.name, core_routes.model_path(file.model) %></p>
  <p class="da-path"><%= file.model.library.name %> / <%= copy.indexed_path %></p>

  <% if file.has_render? %>
    <% format = file.attachment_attacher.derivatives[:render].extension.presence || "png" %>
    <%= image_tag native_file_url(file, derivative: "render", format: format),
      loading: "lazy", alt: "Preview of #{file.filename}", class: "da-preview" %>
  <% elsif file.is_image? %>
    <%= image_tag native_file_url(file, format: file.extension),
      loading: "lazy", alt: "Preview of #{file.filename}", class: "da-preview" %>
  <% elsif file.is_3d_model? || file.is_slicer_file? %>
    <details class="da-render" data-preview>
      <summary>Load 3D preview</summary>
      <template><iframe data-preview-url="<%= native_file_url(file, embed: "true") %>" title="3D preview of <%= file.filename %>"></iframe></template>
      <noscript><%= link_to "Open 3D preview", native_file_url(file, embed: "true") %></noscript>
    </details>
  <% end %>

  <dl class="da-facts">
    <div><dt>Indexed size</dt><dd><%= number_to_human_size(copy.size) %></dd></div>
    <div><dt>Other files in model</dt><dd><%= [@model_file_counts.fetch(copy.model_id, 1) - 1, 0].max %></dd></div>
  </dl>

  <% roles = roles_for(copy, file) %>
  <% if roles.any? %>
    <ul class="da-badges" aria-label="File roles">
      <% roles.each do |role| %>
        <li class="da-pill"><%= role %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="da-actions">
    <%= link_to "Open file", native_file_url(file), class: "da-button" %>
    <% if side.nil? %>
      <% compare = {copies: @page, left: @left.public_id, right: @right.public_id} %>
      <%= link_to "Use on left", group_url(@digest, **compare.merge(left: copy.public_id)), class: "da-button",
        aria: {label: "Use on left, #{copy.indexed_path}"}, data: {inline_link: true, scroll_to_pair: true} %>
      <%= link_to "Use on right", group_url(@digest, **compare.merge(right: copy.public_id)), class: "da-button",
        aria: {label: "Use on right, #{copy.indexed_path}"}, data: {inline_link: true, scroll_to_pair: true} %>
    <% elsif copy.size <= DuplicateAdjudicator::Verification::LIMIT %>
      <%= button_to "Verify checksum", verify_url, params: {copy: file.public_id}, class: "da-button", form: {data: {inline_form: true}} %>
    <% else %>
      <small class="da-muted">Verification limit is 64 MiB.</small>
    <% end %>
  </div>

  <div class="da-actions da-copy-review">
    <% statuses = {
      "acknowledged" => "Manyfold warning acknowledged",
      "open" => "Manyfold warning open",
      "in_progress" => "Manyfold warning in progress"
    } %>
    <p class="da-muted" data-copy-warning-status><%= statuses.fetch(warning_state, "No Manyfold warning") %></p>
    <% unless SiteSettings.demo_mode_enabled? || warning_state == "in_progress" %>
      <% [["acknowledge", "Acknowledge copy", warning_state == "acknowledged"],
           ["reopen", "Reopen copy", warning_state != "acknowledged"]].each do |action, label, hide| %>
        <%= button_to label, group_action_url("warnings"),
          params: {warning_action: action, fingerprint: @snapshot.fingerprint, copy: copy.public_id},
          class: "da-button", form: {data: {inline_form: true, copy_warning_action: action}, hidden: hide} %>
      <% end %>
    <% end %>
  </div>

  <% if @verification&.fetch(:id) == file.id %>
    <% messages = {
      verified: "Verified. The stored file matches the indexed checksum.",
      different: "Checksum differs. The stored file has changed since it was indexed.",
      missing: "The file is missing from its indexed storage location.",
      too_large: "The stored file exceeds the 64 MiB verification limit.",
      unavailable: "Manyfold could not read the stored attachment."
    } %>
    <p class="da-note" role="status" tabindex="-1" data-action-result><%= messages.fetch(@verification.fetch(:result)) %></p>
  <% end %>
</article>
