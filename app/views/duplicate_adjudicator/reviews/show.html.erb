<%= render "assets" %>

<div class="da" data-turbo="false" data-review-namespace="<%= review_namespace %>" data-import-url="<%= review_import_url %>" data-import-csrf="<%= form_authenticity_token %>">
  <header class="da-header">
    <h1>Compare duplicate files</h1>
    <%= link_to "Duplicate queue", queue_url %>
  </header>
  <div class="da-body">
    <%= render "comparison" %>
    <nav aria-label="Continue review" class="da-actions">
      <%= link_to "Back to queue", queue_url, class: "da-button" %>
      <% if @next_group %>
        <%= link_to "Next group", group_url(@next_group.digest), class: "da-button da-primary" %>
      <% end %>
    </nav>
  </div>
</div>
