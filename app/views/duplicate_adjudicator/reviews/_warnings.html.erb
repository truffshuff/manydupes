<section class="da-panel da-section">
  <h2>Copy acknowledgments</h2>
  <p data-copy-acknowledgment-count role="status"><%= @ignored_warnings %> of <%= @snapshot.copies.size %> copies acknowledged</p>

  <% if @warning_feedback %>
    <p class="da-note" role="status" tabindex="-1" data-action-result><%= @warning_feedback %></p>
  <% end %>

  <p class="da-muted">
    <% if (@open_warnings + @ignored_warnings + @busy_warnings).zero? %>
      Manyfold recorded no duplicate warnings for this group.
    <% else %>
      Manyfold warnings · <%= @open_warnings %> open · <%= @ignored_warnings %> acknowledged<%= " · #{@busy_warnings} in progress" if @busy_warnings.positive? %>
    <% end %>
  </p>
  <% if @group_copy_progress[:unwarned].any? %>
    <p class="da-muted">Acknowledgments for copies without a Manyfold warning are saved in this browser.</p>
  <% end %>
  <p class="da-note" data-copy-review-error role="status" hidden></p>

  <div class="da-actions">
    <% unless SiteSettings.demo_mode_enabled? %>
      <%= button_to "Acknowledge all #{@snapshot.copies.size} copies", group_action_url("warnings"),
        params: {warning_action: "acknowledge", fingerprint: @snapshot.fingerprint},
        class: "da-button da-primary", form: {data: {inline_form: true, group_copy_action: "acknowledge"},
          hidden: @open_warnings.zero? && @group_copy_progress[:unwarned].empty?} %>
      <%= button_to "Reopen group", group_action_url("warnings"),
        params: {warning_action: "reopen", fingerprint: @snapshot.fingerprint},
        class: "da-button", form: {data: {inline_form: true, group_copy_action: "reopen"}, hidden: @ignored_warnings.zero?} %>
    <% end %>
    <%= link_to "Open Manyfold Problems", core_routes.problems_path(category: ["duplicate"], show_ignored: "true"), class: "da-button" %>
  </div>
</section>
