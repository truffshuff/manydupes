<section class="da-comparison" tabindex="-1" data-comparison data-group-digest="<%= @digest %>" data-fingerprint="<%= @snapshot.fingerprint %>" data-review-label="<%= @group_review_label %>"
    data-copy-progress="<%= @group_copy_progress.to_json %>"
    data-saved-review="<%= @saved_review.to_json %>">
  <div class="da-comparison-heading">
    <p><%= pluralize(@snapshot.copies.size, "indexed copy") %> in <%= pluralize(@snapshot.copies.map(&:model_id).uniq.size, "model") %>
      across <%= pluralize(@snapshot.copies.map(&:library_id).uniq.size, "library") %>.</p>
    <p class="da-muted" data-copy-acknowledgment-count role="status"><%= @ignored_warnings %> of <%= @snapshot.copies.size %> copies acknowledged</p>
    <details class="da-checksum">
      <summary>Recorded SHA-512 checksum</summary>
      <code><%= @digest %></code>
    </details>
  </div>

  <% if @snapshot.path_counts.values.any? { |count| count > 1 } %>
    <p class="da-note">Some records point to the same indexed storage path. Treat those records as one location when choosing a copy.</p>
  <% end %>

  <% choices = @compare_copies.map do |copy|
    library = @records.fetch(copy.id).model.library
    ["#{library.name} / #{copy.indexed_path} (#{copy.name})", copy.public_id]
  end %>

  <%= form_with url: group_url(@digest, library: nil, q: nil, after: nil, sort: nil), method: :get, local: true, class: "da-panel da-filters", data: {inline_form: true} do %>
    <%= hidden_field_tag :library, @library.public_id, id: nil if @library %>
    <%= hidden_field_tag :q, @search, id: nil if @search.present? %>
    <%= hidden_field_tag :after, @after, id: nil if @after %>
    <%= hidden_field_tag :copies, @page, id: nil %>
    <%= hidden_field_tag :review, @review_view, id: nil if @review_view %>
    <%= hidden_field_tag :sort, @sort, id: nil if @sort %>
    <div>
      <%= label_tag "da-left-#{@digest}", "Left copy" %>
      <%= select_tag :left, options_for_select(choices, @left.public_id), id: "da-left-#{@digest}", class: "form-select" %>
    </div>
    <div>
      <%= label_tag "da-right-#{@digest}", "Right copy" %>
      <%= select_tag :right, options_for_select(choices, @right.public_id), id: "da-right-#{@digest}", class: "form-select" %>
    </div>
    <%= submit_tag "Compare", class: "da-button da-primary" %>
  <% end %>

  <% selected_sides = {@left.id => "Left copy", @right.id => "Right copy"} %>
  <% selected_copies = selected_sides.keys.map { |id| @copy_by_id.fetch(id) } %>
  <% cards = selected_copies + @compare_copies.reject { |copy| selected_sides.key?(copy.id) } %>
  <div class="da-compare" data-copy-columns="<%= [cards.size, 4].min %>">
    <% cards.each do |copy| %>
      <%= render "copy", file: @records.fetch(copy.id), copy: copy, side: selected_sides[copy.id] %>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav aria-label="Indexed copies pages" class="da-actions">
      <% compare = {left: @left.public_id, right: @right.public_id} %>
      <% if @page > 1 %>
        <%= link_to "Previous copies", group_url(@digest, **compare, copies: @page - 1), class: "da-button", data: {inline_link: true, scroll_to_pair: true} %>
      <% end %>
      <span>Page <%= @page %> of <%= @total_pages %></span>
      <% if @page < @total_pages %>
        <%= link_to "More copies", group_url(@digest, **compare, copies: @page + 1), class: "da-button", data: {inline_link: true, scroll_to_pair: true} %>
      <% end %>
    </nav>
  <% end %>

  <%= render "warnings" %>

  <% unless SiteSettings.demo_mode_enabled? %>
    <section class="da-panel da-decision" data-decision-panel>
      <h2>Review decision</h2>
      <%= form_with url: group_action_url("decision"), method: :post, local: true, data: {inline_form: true} do %>
        <%= hidden_field_tag :fingerprint, @snapshot.fingerprint, id: nil %>
        <div class="da-actions da-decision-inputs">
          <div>
            <label for="da-preferred-<%= @digest %>">Preferred copy</label>
            <% preferred = @saved_review.dig("decision", "copy") if @saved_review && @saved_review["fingerprint"] == @snapshot.fingerprint %>
            <%= select_tag :preferred, options_for_select(choices, preferred), include_blank: "Choose a copy",
              id: "da-preferred-#{@digest}", data: {preferred_copy: true}, class: "form-select" %>
          </div>
          <%= button_tag "Save preference", name: "decision", value: "prefer", class: "da-button da-primary" %>
        </div>
        <div class="da-actions">
          <%= button_tag "Keep all copies", name: "decision", value: "keep", class: "da-button" %>
          <%= button_tag "Mark reviewed", name: "decision", value: "reviewed", class: "da-button" %>
          <%= button_tag "Review later", name: "decision", value: "later", class: "da-button" %>
          <%= button_tag "Clear decision", name: "decision", value: "clear",
            class: "da-button da-quiet", data: {clear_decision: true}, hidden: !@saved_review&.dig("decision") %>
        </div>
      <% end %>
      <% if @review_feedback %>
        <p class="da-note" data-action-result role="status" tabindex="-1"><%= @review_feedback %></p>
      <% end %>
      <p data-decision-status role="status"></p>
    </section>

  <% end %>

  <%= render "storage" %>

</section>
