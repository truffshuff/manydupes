<section class="da-panel da-section">
  <h2>Disk space</h2>
  <p class="da-muted">A hard link can keep both paths and collection entries while sharing the stored bytes. Editing either file in place would affect both.</p>
  <%= button_to "Check disk savings for right copy", group_action_url("storage"),
    class: "da-button", form: {data: {inline_form: true}} %>
  <% if @storage %>
    <% description = {
      nonlocal: "This check requires two filesystem-backed files.",
      unavailable: "A regular file could not be read at each indexed path.",
      same_file: "Both paths already use the same filesystem file. There is no second allocation to reclaim.",
      size_changed: "The stored size differs from the index. Rescan before estimating savings.",
      different_filesystems: "The selected files are on different devices. Hard links require the same mounted filesystem.",
      linked_elsewhere: "The right copy already has other hard links. Changing only this path would leave its bytes allocated.",
      different_attributes: "The selected files have different ownership or permissions. A hard link would share those attributes.",
      possible: @storage.bytes ? "The right copy uses about #{number_to_human_size(@storage.bytes)} of allocated space. A hard link could reclaim up to that amount if the live checksums match and the filesystem supports linking the paths." :
        "The pair appears eligible by filesystem metadata. Reclaimable bytes could not be estimated."
    } %>
    <p class="da-note" role="status" tabindex="-1" data-action-result><%= description.fetch(@storage.status) %> This check leaves both files in place.</p>
  <% end %>
</section>
